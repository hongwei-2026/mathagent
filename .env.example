# OpenAI-compatible API (OpenAI / DeepSeek / Azure / Ollama / vLLM)
MATHAGENT_API_KEY=sk-your-key
MATHAGENT_BASE_URL=https://api.deepseek.com/v1
MATHAGENT_MODEL=deepseek-chat
MATHAGENT_FORMAL_MODEL=deepseek-reasoner

# Optional
# MATHAGENT_TEMPERATURE=0.0
# MATHAGENT_MAX_TURNS=12

# Lean 4 — keep toolchain + workspace on D:
MATHAGENT_LEAN_HOME=D:/lean/elan
MATHAGENT_LEAN_WORKSPACE=D:/mathagent/lean_workspace
MATHAGENT_LEAN_TMP=D:/lean/tmp
MATHAGENT_LEAN_CACHE=D:/lean/cache

